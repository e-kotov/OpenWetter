[Unit]
Description=OpenWetter: publish DWD ICON-D2 map layers, chart series and history to Cloudflare R2
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=openwetter
Group=openwetter
EnvironmentFile=/etc/openwetter/r2.env
# flock: never run at the same time as the live (radar/nowcast/warnings) job on this small server.
ExecStart=/usr/bin/flock -w 1200 /var/lib/openwetter/publish.lock /opt/openwetter/bin/icon-rs icon --publish --state /var/lib/openwetter/state.json --history-days 5 --grace-minutes 30 --max-uploads-month 500000 --live-dir /var/lib/openwetter
StateDirectory=openwetter
# Measured peak ~95 MB (macOS) for all layers; the cap protects the other services.
MemoryMax=180M
MemorySwapMax=0
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=40min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
